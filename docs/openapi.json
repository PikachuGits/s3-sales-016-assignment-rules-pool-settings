  "components": {
    "schemas": {
      "AssignmentRuleCreate": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Name",
            "examples": [
              "华东制造业轮询"
            ]
          },
          "strategy": {
            "type": "string",
            "enum": [
              "round_robin",
              "least_holding",
              "fixed_user"
            ],
            "title": "Strategy",
            "examples": [
              "round_robin"
            ]
          },
          "conditions": {
            "additionalProperties": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "type": "object",
            "title": "Conditions",
            "description": "Condition object. Keys and literals must come from the v1 condition vocabulary documented in README §5.",
            "examples": [
              {
                "industry": [
                  "manufacturing"
                ],
                "region": [
                  "east"
                ]
              }
            ]
          },
          "member_user_ids": {
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "type": "array",
            "minItems": 1,
            "title": "Member User Ids",
            "description": "Consultants of this site; fixed_user requires exactly one."
          },
          "work_hours": {
            "items": {
              "$ref": "#/components/schemas/WorkHourWindow"
            },
            "type": "array",
            "minItems": 1,
            "title": "Work Hours"
          },
          "priority": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Priority",
            "default": 100,
            "examples": [
              10
            ]
          },
          "enabled": {
            "type": "boolean",
            "title": "Enabled",
            "default": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "strategy",
          "member_user_ids",
          "work_hours"
        ],
        "title": "AssignmentRuleCreate",
        "description": "Payload for ``POST /api/sales/assignment-rules``."
      },
      "AssignmentRuleList": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/AssignmentRuleOut"
            },
            "type": "array",
