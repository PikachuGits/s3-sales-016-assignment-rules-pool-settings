{
  "openapi": "3.1.0",
  "info": {
    "title": "Sales assignment & pool settings API",
    "description": "\nAssignment-rule and public-pool configuration APIs for the membership-space\nplatform (Stage iii · sales workspace v1).\n\n**Out of scope:** the assignment engine itself, lead/customer ingestion and\nfront-end screens. This service only owns configuration persistence, validation\nand the configuration change log.\n\n**Authentication:** S2-IAM is stubbed. The gateway must inject `X-User-Id`,\n`X-Org-Id`, `X-Site-Id` and `X-Role` (`sys_admin` / `club_owner` /\n`supervisor` / `consultant`). Replace `app.iam.get_principal` with the real\nIAM introspection call in production.\n",
    "version": "1.0.0"
  },
  "paths": {
    "/api/sales/assignment-rules": {
      "get": {
        "tags": [
          "sales-assignment"
        ],
        "summary": "List assignment rules",
        "description": "Returns rules of the caller's site ordered by priority. Disabled rules are hidden unless include_disabled=true. Consultants are not allowed to read rule details.",
        "operationId": "list_assignment_rules_api_sales_assignment_rules_get",
        "parameters": [
          {
            "name": "include_disabled",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false,
              "title": "Include Disabled"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 200,
              "minimum": 1,
              "default": 100,
              "title": "Limit"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "title": "Offset"
            }
          },
          {
            "name": "X-User-Id",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-User-Id"
            }
          },
          {
            "name": "X-Org-Id",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Org-Id"
            }
          },
          {
            "name": "X-Site-Id",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Site-Id"
            }
          },
          {
            "name": "X-Role",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Role"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssignmentRuleList"
                }
              }
            }
          },
          "403": {
            "description": "The caller's role is not allowed for this operation."
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "sales-assignment"
        ],
        "summary": "Create an assignment rule",
        "operationId": "create_assignment_rule_api_sales_assignment_rules_post",
        "parameters": [
          {
